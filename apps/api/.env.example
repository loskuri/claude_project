# ============================================================
#  NutriPlan - Variables de entorno del servidor
#  Copiá este archivo como .env y completá los valores
# ============================================================

# Base de datos (no cambies esto si usas Docker)
DATABASE_URL=postgresql://nutriplan:nutriplan_dev@localhost:5432/nutriplan

# Redis (no cambies esto si usas Docker)
REDIS_URL=redis://localhost:6379

# Claves JWT - Podés usar cualquier texto largo (min 32 caracteres)
# Generá una en: https://passwordsgenerator.net/ (32+ chars)
JWT_ACCESS_SECRET=cambia-esto-por-un-texto-largo-y-secreto-32ch
JWT_REFRESH_SECRET=cambia-esto-por-otro-texto-largo-y-secreto-32c

# Duracion de los tokens (no necesitas cambiar esto)
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=30d

# Provider de IA: "claude" (Anthropic) o "openai" (ChatGPT)
AI_PROVIDER=claude

# Modelo a usar (opcional - usa el default del provider si se deja vacío)
# Claude: claude-sonnet-4-6, claude-haiku-3-5, etc.
# OpenAI: gpt-4o, gpt-4o-mini, gpt-4-turbo, etc.
AI_MODEL=

# Clave de Anthropic (requerida si AI_PROVIDER=claude)
# Conseguila en: https://console.anthropic.com
ANTHROPIC_API_KEY=sk-ant-PEGA-TU-KEY-AQUI

# Clave de OpenAI (requerida si AI_PROVIDER=openai)
# Conseguila en: https://platform.openai.com/api-keys
OPENAI_API_KEY=

# Clave de USDA para alimentos (DEMO_KEY funciona para pruebas)
USDA_API_KEY=DEMO_KEY

# Mercado Libre API (para fetchear precios de vendedores)
# Creá una app gratis en: https://developers.mercadolibre.com.ar
# En la app encontrás el "App ID" (CLIENT_ID) y "Secret key" (CLIENT_SECRET)
ML_CLIENT_ID=TU_APP_ID_AQUI
ML_CLIENT_SECRET=TU_SECRET_KEY_AQUI

# Puerto del servidor (no cambies esto)
PORT=3001
NODE_ENV=development
